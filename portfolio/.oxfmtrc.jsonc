{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // 既定では .astro を整形しない。整形に使う @astrojs/compiler-rs は oxfmt に含まれないため、devDependencies に入れている
  // https://github.com/oxc-project/oxc/blob/oxfmt_v0.79.0/apps/oxfmt/src-js/config.generated.ts#L96-L108
  "astro": true,
  "sortImports": true,
  // trailingComma の既定の all は JSONC にも末尾カンマを付け、VS Code がそれを警告するため、付けさせない。変えるときはルートの .oxfmtrc.jsonc も合わせる
  // https://code.visualstudio.com/docs/languages/json#_json-with-comments
  "overrides": [
    {
      "files": ["**/*.jsonc"],
      "options": { "trailingComma": "none" }
    }
  ]
}
