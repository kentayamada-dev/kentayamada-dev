{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  // files のパターンは、このファイルの場所ではなく、extends する portfolio/.oxlintrc.jsonc の場所を基準にする。
  // extends 先の overrides は読み替えずに、extends した側の overrides の前に連結されるため
  // https://github.com/oxc-project/oxc/blob/oxlint_v1.94.0/crates/oxc_linter/src/config/oxlintrc.rs#L447-L448
  "overrides": [
    {
      // frontmatter で使う Astro グローバルと、<script> で使う document などのブラウザのグローバル変数を、nursery の eslint/no-undef に未定義と判定させないため。
      // 既定の環境は ECMAScript のグローバル変数だけ
      // https://docs.astro.build/en/reference/api-reference/ https://github.com/oxc-project/oxc/blob/oxlint_v1.94.0/apps/oxlint/src-js/generated/envs.ts#L43-L46
      // https://github.com/oxc-project/oxc/blob/oxlint_v1.94.0/crates/oxc_linter/src/config/env.rs#L65-L68
      "files": ["**/*.astro"],
      "env": { "astro": true, "browser": true },
      // oxlint は frontmatter を切り出して単独で検査し、import のない frontmatter をスクリプトと見分けられないと報告する。
      // .astro は Astro がコンパイルするファイルで、単独のスクリプトとして読まれることはない
      // https://github.com/oxc-project/oxc/blob/oxlint_v1.94.0/crates/oxc_linter/src/loader/partial_loader/astro.rs#L34-L60
      "rules": { "import/unambiguous": "off" }
    },
    {
      // Astro と Playwright の設定ファイルは、設定を default export で渡す形のため
      // https://docs.astro.build/en/guides/configuring-astro/#the-astro-config-file
      // https://github.com/microsoft/playwright/blob/v1.65.1/docs/src/test-configuration-js.md?plain=1#L17
      "files": ["astro.config.ts", "playwright.config.ts"],
      "rules": { "import/no-default-export": "off" }
    },
    {
      // ブラウザで動く src/ の TypeScript で使う document などを、eslint/no-undef に未定義と判定させないため
      "files": ["src/**/*.ts"],
      "env": { "browser": true }
    },
    {
      // ミドルウェアが受け取る APIContext などの型は、Astro が決めていて readonly ではないため、型を書かない引数は対象にしない
      // https://github.com/withastro/astro/blob/astro%407.4.13/packages/astro/src/types/public/context.ts#L60
      "files": ["src/middleware.ts"],
      "rules": {
        "typescript/prefer-readonly-parameter-types": ["error", { "ignoreInferredTypes": true }]
      }
    }
  ]
}
