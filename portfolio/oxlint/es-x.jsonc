{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["eslint-plugin-es-x"],
  // browserslist の既定の範囲（よく使われているブラウザ）に、対応していないブラウザが入る ES2023 以降の機能を使わせない。
  // 規則を足す・外すときは、scripts/es-x-features.json の MDN のデータとの対応も合わせる
  "rules": {
    // メソッドの規則は、型がわからないと報告しないため、aggressive にして変数に対しても報告させる
    // https://github.com/eslint-community/eslint-plugin-es-x/blob/v10.1.0/docs/rules/no-array-prototype-tosorted.md?plain=1#L14
    "es-x/no-array-prototype-toreversed": ["error", { "aggressive": true }],
    "es-x/no-array-prototype-tosorted": ["error", { "aggressive": true }],
    "es-x/no-array-prototype-tospliced": ["error", { "aggressive": true }],
    "es-x/no-array-prototype-with": ["error", { "aggressive": true }],
    "es-x/no-arraybuffer-prototype-transfer": ["error", { "aggressive": true }],
    "es-x/no-resizable-and-growable-arraybuffers": ["error", { "aggressive": true }],
    "es-x/no-string-prototype-iswellformed": ["error", { "aggressive": true }],
    "es-x/no-string-prototype-towellformed": ["error", { "aggressive": true }],
    "es-x/no-dataview-prototype-getfloat16-setfloat16": ["error", { "aggressive": true }],
    "es-x/no-set-prototype-difference": ["error", { "aggressive": true }],
    "es-x/no-set-prototype-intersection": ["error", { "aggressive": true }],
    "es-x/no-set-prototype-isdisjointfrom": ["error", { "aggressive": true }],
    "es-x/no-set-prototype-issubsetof": ["error", { "aggressive": true }],
    "es-x/no-set-prototype-issupersetof": ["error", { "aggressive": true }],
    "es-x/no-set-prototype-symmetricdifference": ["error", { "aggressive": true }],
    "es-x/no-set-prototype-union": ["error", { "aggressive": true }],
    "es-x/no-map-prototype-getorinsert": ["error", { "aggressive": true }],
    "es-x/no-map-prototype-getorinsertcomputed": ["error", { "aggressive": true }],
    "es-x/no-uint8array-prototype-setfrombase64": ["error", { "aggressive": true }],
    "es-x/no-uint8array-prototype-setfromhex": ["error", { "aggressive": true }],
    "es-x/no-uint8array-prototype-tobase64": ["error", { "aggressive": true }],
    "es-x/no-uint8array-prototype-tohex": ["error", { "aggressive": true }],
    "es-x/no-weakmap-prototype-getorinsert": ["error", { "aggressive": true }],
    "es-x/no-weakmap-prototype-getorinsertcomputed": ["error", { "aggressive": true }],
    "es-x/no-date-prototype-totemporalinstant": ["error", { "aggressive": true }],
    // Iterator のメソッドは配列のメソッドと名前が同じで、aggressive にすると配列の呼び出しまで報告されるため、Iterator とわかるときだけ報告させる
    "es-x/no-iterator-prototype-chunks": "error",
    "es-x/no-iterator-prototype-drop": "error",
    "es-x/no-iterator-prototype-every": "error",
    "es-x/no-iterator-prototype-filter": "error",
    "es-x/no-iterator-prototype-find": "error",
    "es-x/no-iterator-prototype-flatmap": "error",
    "es-x/no-iterator-prototype-foreach": "error",
    "es-x/no-iterator-prototype-includes": "error",
    "es-x/no-iterator-prototype-join": "error",
    "es-x/no-iterator-prototype-map": "error",
    "es-x/no-iterator-prototype-reduce": "error",
    "es-x/no-iterator-prototype-some": "error",
    "es-x/no-iterator-prototype-take": "error",
    "es-x/no-iterator-prototype-toarray": "error",
    "es-x/no-iterator-prototype-windows": "error",
    "es-x/no-array-fromasync": "error",
    "es-x/no-asyncdisposablestack": "error",
    "es-x/no-atomics-pause": "error",
    "es-x/no-disposablestack": "error",
    "es-x/no-error-iserror": "error",
    "es-x/no-float16array": "error",
    "es-x/no-import-attributes": "error",
    "es-x/no-iterator": "error",
    "es-x/no-iterator-concat": "error",
    "es-x/no-iterator-zip": "error",
    "es-x/no-iterator-zipkeyed": "error",
    "es-x/no-json-israwjson": "error",
    "es-x/no-json-modules": "error",
    "es-x/no-json-parse-reviver-context-parameter": "error",
    "es-x/no-json-rawjson": "error",
    "es-x/no-map-groupby": "error",
    "es-x/no-math-f16round": "error",
    "es-x/no-math-sumprecise": "error",
    "es-x/no-object-groupby": "error",
    "es-x/no-promise-try": "error",
    "es-x/no-promise-withresolvers": "error",
    "es-x/no-regexp-duplicate-named-capturing-groups": "error",
    "es-x/no-regexp-escape": "error",
    "es-x/no-regexp-modifiers": "error",
    "es-x/no-regexp-v-flag": "error",
    "es-x/no-suppressederror": "error",
    "es-x/no-symbol-asyncdispose": "error",
    "es-x/no-symbol-dispose": "error",
    "es-x/no-temporal": "error",
    "es-x/no-uint8array-frombase64": "error",
    "es-x/no-uint8array-fromhex": "error",
    "es-x/no-using-declarations": "error"
  }
}
