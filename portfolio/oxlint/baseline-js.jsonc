{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["eslint-plugin-baseline-js"],
  "rules": {
    "baseline-js/use-baseline": [
      "error",
      {
        // 変えるときは、CSS の変換の対象を決める .browserslistrc も合わせる
        "available": "newly",
        // Web API と JS の組み込みの判定は、指定しないと無効になるため
        // https://github.com/3ru/eslint-plugin-baseline-js/blob/v0.7.7/src/orchestrator/use-baseline.ts#L170-L171
        "includeWebApis": { "preset": "auto" },
        "includeJsBuiltins": { "preset": "auto" }
      }
    ]
  }
}
