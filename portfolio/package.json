  "dependencies": {
    "astro": "7.4.13",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler-rs": "0.5.3",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "browserslist": "4.29.6",
    "eslint-plugin-baseline-js": "0.7.7",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-security": "4.2.1",
    "knip": "6.46.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vnu-jar": "26.11.20"
  },
  "devEngines": {
