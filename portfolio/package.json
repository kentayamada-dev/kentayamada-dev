  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler-rs": "0.5.3",
    "@mdn/browser-compat-data": "8.1.10",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "browserslist": "4.29.6",
    "eslint-plugin-baseline-js": "0.7.7",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-es-x": "10.1.0",
    "eslint-plugin-security": "4.2.1",
    "knip": "6.46.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "devEngines": {
