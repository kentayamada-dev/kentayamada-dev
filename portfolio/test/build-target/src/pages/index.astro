---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>build-target</title>
  </head>
  <body>
    <p class="probe">probe</p>
    <script>
      // 対応ブラウザにない構文で、ビルドで書き換えられることを確かめる。対応ブラウザが using 宣言に対応したら、
      // 対応していない別の構文に替え、portfolio-check のワークフローで探す文字列も合わせる
      {
        using resource = {
          [Symbol.dispose]() {
            console.log("disposed");
          },
        };
        console.log(resource);
      }
    </script>
  </body>
</html>

<style>
  /* Safari では -webkit- 付きでしか使えず、ビルドでプレフィックスが足されることを確かめる。
     対応ブラウザがプレフィックスなしで使えるようになったら、別の宣言に替え、portfolio-check のワークフローで探す文字列も合わせる */
  .probe {
    user-select: none;
  }
</style>
